<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="payment_provider_form_jetframe" model="ir.ui.view">
        <field name="name">payment.provider.form.jetframe</field>
        <field name="model">payment.provider</field>
        <field name="inherit_id" ref="payment.payment_provider_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='provider_credentials']" position="inside">
                <group
                    string="Paycomet JET"
                    invisible="code != 'jetframe'"
                    name="jetframe_credentials"
                >
                    <field
                        name="paycomet_terminal_id"
                        required="code == 'jetframe' and state != 'disabled'"
                        placeholder="p. ej. 60811"
                    />
                    <field
                        name="paycomet_api_key"
                        password="True"
                        required="code == 'jetframe' and state != 'disabled'"
                        placeholder="API Key del back-office de Paycomet"
                    />
                </group>
            </xpath>
        </field>
    </record>

    <!--
        List view: show paycomet_is_instant_credit and paycomet_order on the
        payment.transaction tree so operators can identify IC transactions at a glance.
    -->
    <record id="payment_transaction_list_jetframe" model="ir.ui.view">
        <field name="name">payment.transaction.list.jetframe</field>
        <field name="model">payment.transaction</field>
        <field name="inherit_id" ref="payment.payment_transaction_list"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='reference']" position="after">
                <field name="paycomet_order" optional="hide"/>
                <field name="paycomet_is_instant_credit" optional="hide"
                       string="IC" widget="boolean"/>
            </xpath>
        </field>
    </record>

    <!--
        Form view: show paycomet fields on the transaction detail page.
    -->
    <record id="payment_transaction_form_jetframe" model="ir.ui.view">
        <field name="name">payment.transaction.form.jetframe</field>
        <field name="model">payment.transaction</field>
        <field name="inherit_id" ref="payment.payment_transaction_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='reference']" position="after">
                <field name="paycomet_order"
                       invisible="provider_code != 'jetframe'"
                       readonly="1"/>
                <field name="paycomet_is_instant_credit"
                       invisible="provider_code != 'jetframe'"
                       readonly="1"
                       string="Financiación Instant Credit"/>
            </xpath>
        </field>
    </record>
</odoo>
