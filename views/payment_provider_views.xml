<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- =====================================================================
         Payment Provider form — Paycomet JET credentials & configuration
         ===================================================================== -->
    <record id="payment_provider_form_jetframe" model="ir.ui.view">
        <field name="name">payment.provider.form.jetframe</field>
        <field name="model">payment.provider</field>
        <field name="inherit_id" ref="payment.payment_provider_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='provider_credentials']" position="inside">
                <group
                    string="Paycomet JET — Credenciales"
                    invisible="code != 'jetframe'"
                    name="jetframe_credentials"
                    colspan="2"
                >
                    <!-- Terminal ID -->
                    <field
                        name="paycomet_terminal_id"
                        required="code == 'jetframe' and state != 'disabled'"
                        placeholder="p. ej. 60811"
                    />

                    <!-- API Key (masked) -->
                    <field
                        name="paycomet_api_key"
                        password="True"
                        required="code == 'jetframe' and state != 'disabled'"
                        placeholder="API Key del back-office de Paycomet"
                    />

                    <!-- ── API URL ────────────────────────────────────────────
                         Allows switching between production and test endpoints.

                         Paycomet provides the same REST API host for both
                         environments (https://rest.paycomet.com), but some
                         integrators or Paycomet sandbox environments may have
                         a different base URL.

                         This field drives ALL API calls:
                           • {url}/v1/form          → JetFrame hosted form
                           • {url}/v1/payments/…    → operationInfo (IC)
                    ─────────────────────────────────────────────────────── -->
                    <field
                        name="paycomet_api_url"
                        required="code == 'jetframe' and state != 'disabled'"
                        placeholder="https://rest.paycomet.com"
                        widget="url"
                    />

                    <!-- Read-only preview of the computed /v1/form endpoint -->
                    <field
                        name="paycomet_form_url"
                        readonly="1"
                        string="Endpoint activo (/v1/form)"
                        invisible="not paycomet_api_url"
                    />

                </group>
            </xpath>
        </field>
    </record>

</odoo>
